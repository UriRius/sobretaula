# Copia'l a .env.local per a desenvolupament (apunta a la Supabase local).
# `npx supabase status -o env` et dona els valors locals.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Només al servidor (Vercel): el cron que manté Supabase despert.
SUPABASE_SECRET_KEY=sb_secret_...
CRON_SECRET=una-cadena-llarga-i-aleatoria
